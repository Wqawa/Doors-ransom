  <!-- ======================================================================
       输出目录：**显式钉死**，不依赖 $(SolutionDir)

       默认值是 $(SolutionDir)$(Platform)\$(Configuration)\，也就是
       「解决方案放哪儿产物就在哪儿」——同一个工程换个地方开，产物和中间
       文件就跟着到处跑（本工程就被这么坑过：中间文件散在 Ransom_dev\
       Ransom_dev\x64\ 里）。这里统一固定到仓库根的 build\ 下面：
           build\x64\Release\       <- 直接可分发（exe + assets\）
           build\x64\Debug\
           build\obj\x64\Release\   <- 中间文件单独一层

       用 $(MSBuildThisFileDirectory)（= 本 vcxproj 所在目录）而不是
       $(SolutionDir)：后者在直接编译 vcxproj 时会被上层预设成工程目录，
       条件判断根本不生效，锚在工程文件自己身上才跟解决方案放哪儿无关。
       ====================================================================== -->
  <PropertyGroup Label="OutputLayout">
    <OutDir>$(MSBuildThisFileDirectory)..\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\build\obj\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>Ransom_dev</TargetName>
  </PropertyGroup>

