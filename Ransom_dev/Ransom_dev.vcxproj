  <!-- ======================================================================
       素材打包：assets\ 整个目录编成 exe 里的 RCDATA 资源

       assets_gen.rc / assets_gen.txt 由 tools\gen_assets.ps1 生成，
       Ransom_dev.rc 里 #include 前者。

       这个目标**每次构建都跑**，但生成脚本只在内容真的变了才写文件。
       为什么不用 Inputs/Outputs 做增量：MSBuild 比的是时间戳，而新素材
       完全可能是旧时间戳（Copy-Item 和 unzip 都会保留原时间），
       那样增量判断会安静地跳过新文件——实测踩到过。
       比内容则任何情况都对，而且「没变就不写」意味着 .rc 时间戳不动，
       rc.exe 和链接器都不会被惊动，构建不会变慢。

       生成失败不挡构建：继续用上一版清单（只有连 .rc 都没有才报错）。
       ====================================================================== -->
  <Target Name="GenerateAssetResources" BeforeTargets="ResourceCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\gen_assets.ps1&quot;"
          ContinueOnError="true" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)assets_gen.rc')"
           Text="assets_gen.rc 不存在，且自动生成失败。手动跑： powershell -ExecutionPolicy Bypass -File tools\gen_assets.ps1" />
  </Target>

  <!-- 素材只作为**打包输入**存在，不再复制到产物目录：
       全部内嵌进 exe 之后，产物就该是干干净净一个文件。
       挂在 None 上只是为了在解决方案资源管理器里看得到。 -->
  <ItemGroup>
    <None Include="..\assets\**\*.*">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="assets_gen.rc" />
    <None Include="assets_gen.txt" />
    <None Include="..\tools\gen_assets.ps1">
      <Link>tools\gen_assets.ps1</Link>
    </None>
  </ItemGroup>

