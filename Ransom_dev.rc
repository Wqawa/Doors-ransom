// ============================================================================
//  Ransom_dev.rc
//
//  这个文件只做两件事：
//    1. 应用图标（资源 ID = 1）
//    2. #include 进 assets_gen.rc，把整个 assets\ 编成 RCDATA 资源
//
//  图标：资源管理器 / 任务栏里看到的 exe 图标就是它。
//  窗口自己的图标也走它——aero::SetAppIconFromSelf() 直接用 exe 内置的
//  这个图标资源（LoadImageW + MAKEINTRESOURCE(1)）。
//  ID 取 1：.rc 里 ID 最小的图标会被 Shell 当成应用程序图标。
//
//  素材：assets_gen.rc 由 tools\gen_assets.ps1 扫描 assets\ 生成，
//  每个素材一条 `<PREFIX>_<文件名> RCDATA "..\assets\..."`。
//  运行时 assets.cpp 用 FindResourceW 按名字取，所以 exe 自带全部素材，
//  产物就是一个不依赖任何外部文件的单文件 exe。
//
//  路径都相对本文件所在目录（Ransom_dev\），上一级就是仓库根。
//
//  **路径一律用正斜杠**：RC 在双引号字符串里会把 '\a' '\r' '\n' 当转义
//  序列处理，写 "..\assets\ransom.ico" 实际会去找 "..<BELL>ssets<CR>ansom.ico"。
//  这个坑很安静——图标只是变成没图标，不报错。
// ============================================================================

1 ICON "../assets/ransom.ico"

// 整个 assets\ 的打包清单（自动生成，别手改）
#include "assets_gen.rc"
